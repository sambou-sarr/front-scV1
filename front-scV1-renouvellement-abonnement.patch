+).IS_REACT_ACT_ENVIRONMENT = true;
+
+/* /espace-client/abonnements?renew=<id> ouvre directement la fenêtre de renouvellement de cette fiche. */
+const NOW = Date.now();
+const day = (n: number) => new Date(NOW + n * 86_400_000).toISOString();
+const base = {
+  statut: "ACTIVE",
+  prenom: "Rose",
+  nom: "Ndiaye",
+  subscriptions: [],
+};
+const expired = {
+  ...base,
+  id: 12,
+  slug: "rose-pro",
+  latestSubscription: {
+    status: "EXPIRED",
+    endsAt: day(-20),
+    plan: { type: "PRO" },
+  },
+};
+const active = {
+  ...base,
+  id: 13,
+  slug: "awa-signature",
+  subscriptions: [
+    { endsAt: day(200), status: "ACTIVE", plan: { type: "SIGNATURE" } },
+  ],
+};
+
+const Where = () => {
+  const l = useLocation();
+  return h("i", { id: "where" }, l.pathname + l.search);
+};
+
+describe("SubscriptionPage : lien de renouvellement", () => {
+  const original = api.defaults.adapter;
+  let root: Root;
+  let host: HTMLDivElement;
+
+  beforeEach(() => {
+    host = document.createElement("div");
+    document.body.appendChild(host);
+    root = createRoot(host);
+    api.defaults.adapter = async config => {
+      const mk = (data: unknown) => ({
+        status: 200,
+        data,
+        statusText: "",
+        headers: {},
+        config,
+      });
+      if (config.url === "client/parametres/commande/tarif")
