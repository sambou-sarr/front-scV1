+  section: "menu",
+  quantite: 20,
+  message: null,
+  statut: "demande",
+  createdAt: "2026-10-29T10:00:00Z",
+  activatedAt: null,
+  ...over,
+});
+
+describe("StickerBox : demande de devis", () => {
